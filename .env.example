AMAZON_EMAIL=
AMAZON_PASSWORD=
# Eine ASIN, kommagetrennte Liste oder JSON-Array:
#   ASIN=B07QLY87NH
#   ASIN=B07QLY87NH,B00957T6X6
ASIN=

# Mistral OCR (transcription) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Optional: OCR model (default: mistral-ocr-3; mistral-ocr-latest is newer and
# roughly twice the price). The script lists the available ones if it is wrong.
MISTRAL_OCR_MODEL=
# Optional: pages per batch job (default: 400)
MISTRAL_BATCH_SIZE=
# Optional: minutes to wait for a batch job (default: 180)
MISTRAL_JOB_TIMEOUT_MINUTES=

# Only for the alternative Claude transcription
# (src/transcribe-book-content-claude.ts):
ANTHROPIC_API_KEY=
# Optional: claude-opus-5 for difficult typography, claude-haiku-4-5 to save
# money (but haiku was seen inventing text on decorated pages)
# (default: claude-sonnet-5)
ANTHROPIC_MODEL=
# Optional: parallel page transcriptions (default: 8)
TRANSCRIBE_CONCURRENCY=
# Optional: only transcribe the first N pages — cheap trial run
TRANSCRIBE_LIMIT=

# Optional: TOTP secret for Amazon 2FA — if set, codes are generated locally
# instead of prompted for interactively
AMAZON_TOTP_SECRET=

# Optional: browser for the Kindle web reader if Google Chrome is not installed
# e.g. /usr/bin/brave-browser
CHROME_EXECUTABLE_PATH=
CHROME_CHANNEL=

# Only needed for the optional audiobook export (TTS, still OpenAI/UnrealSpeech)
OPENAI_API_KEY=
