AMAZON_EMAIL=
AMAZON_PASSWORD=
# Eine ASIN, kommagetrennte Liste oder JSON-Array:
#   ASIN=B07QLY87NH
#   ASIN=B07QLY87NH,B00957T6X6
ASIN=

# Claude API (transcription). Falls back to an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Optional: stronger model for tricky typography, e.g. claude-opus-5
# (default: claude-haiku-4-5)
ANTHROPIC_MODEL=
# Optional: parallel page transcriptions (default: 8)
TRANSCRIBE_CONCURRENCY=
# Optional: only transcribe the first N pages — cheap trial run
TRANSCRIBE_LIMIT=

# Optional: TOTP secret for Amazon 2FA — if set, codes are generated locally
# instead of prompted for interactively
AMAZON_TOTP_SECRET=

# Optional: browser for the Kindle web reader if Google Chrome is not installed
# e.g. /usr/bin/brave-browser
CHROME_EXECUTABLE_PATH=
CHROME_CHANNEL=

# Only needed for the optional audiobook export (TTS, still OpenAI/UnrealSpeech)
OPENAI_API_KEY=
